{
  "name": "lumen-panel",
  "version": "0.1.0",
  "private": true,
  "description": "A modern theme for the KeyHelp hosting panel: stylesheets, a command palette island and a design-system gallery",
  "license": "MIT",
  "author": "Paul Pasaurek",
  "homepage": "https://luminare.tech/open-source/lumen-panel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luminare-dev/lumen-panel.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:island && npm run build:gallery",
    "build:css": "node scripts/build-css.mjs",
    "build:island": "vite build --config island/vite.config.js && node scripts/check-island.mjs",
    "build:gallery": "vite build --config gallery/vite.config.js && node scripts/check-gallery.mjs",
    "dev": "npm run build:css && npm run build:island && vite --config gallery/vite.config.js",
    "preview": "vite preview --config gallery/vite.config.js",
    "test": "vitest run --config island/vitest.config.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bulma": "0.9.4",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
