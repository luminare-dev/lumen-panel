{
  "id": "extern-logo",
  "file": "layout/extern.twig",
  "description": "Show the Luminare horizontal lockup on the login and password pages instead of the KeyHelp logo. A white-label login logo still wins. A customization (branding.json) can set its own logos or put KeyHelp's back.",
  "mode": "replace",
  "anchors": {
    "default": "<img src=\"{{ _app.theme.url }}/assets/img/{{ _app.theme.is_dark_mode ? 'dark/' }}keyhelp{{ _app.is_pro ? '-pro' }}.svg?{{ _globals.cache_control }}\" alt=\"logo\">",
    "bulma": "<img src=\"theme/bulma/assets/img/{{ _app.theme.is_dark_mode ? 'dark/' }}keyhelp{{ _app.is_pro ? '-pro' }}.svg?{{ _globals.cache_control }}\" alt=\"logo\">"
  },
  "text": "@@LUMEN_LOGIN_LOGO@@",
  "assets": [
    "brand/luminare-lockup-horizontal-light.svg",
    "brand/luminare-lockup-horizontal-dark.svg"
  ]
}
