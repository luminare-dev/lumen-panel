  "mode": "replace",
  "anchor": "<img src=\"theme/bulma/assets/img/{{ _app.theme.is_dark_mode ? 'dark/' }}keyhelp{{ _app.is_pro ? '-pro' }}.svg?{{ _globals.cache_control }}\" alt=\"logo\">",
  "text": "<img class=\"lumen-logo lumen-logo--login\" src=\"/theme/@@LUMEN_THEME_DIR@@/assets/brand/luminare-lockup-horizontal-dark.svg?v=@@LUMEN_ASSET_HASH@@\" width=\"300\" height=\"114\" alt=\"Luminare Development\">",
  "assets": [
    "brand/luminare-lockup-horizontal-dark.svg"
  ]
}
